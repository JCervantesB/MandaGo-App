{
  "expo": {
    "name": "MandaGo",
    "slug": "mandago",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.imjcervantes.client"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "94dd2b29-dab3-4343-a211-3ba2a35f9171"
      }
    },
    "owner": "imjcervantes",
    "plugins": [
      "expo-secure-store",
      "@maplibre/maplibre-react-native"
    ]
  }
}
